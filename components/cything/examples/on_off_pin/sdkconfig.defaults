# The phone app ships a copy of this file in every ESP-IDF project it
# generates (FirmwareSketchBundle.IDF_SDKCONFIG_DEFAULTS). Keep them in step.
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# BLE Wi-Fi pairing (src/ble): NimBLE host, BLE-only controller. NimBLE
# rather than Bluedroid because the same C API is what the NimBLE-Arduino
# library exposes, so src/ builds unchanged under Arduino — and it is a
# fraction of Bluedroid's size. See doc/ble-pairing.md.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
# Peripheral only: no scanning / central role code.
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_BT_NIMBLE_ROLE_OBSERVER is not set
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Free the mbedTLS record buffers (16 KB in + 4 KB out) while the MQTT/TLS
# link is idle, and the CA/config data after the handshake: the heap they held
# is what a phone's SRP-3072 PAKE and its 10 KB connection task need.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
