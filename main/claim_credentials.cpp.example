/*
 * Per-model claim certificate + private key for the ESP-IDF build.
 *
 * 1. Copy this file to main/claim_credentials.cpp (git-ignored).
 * 2. Copy examples/Basic/claim_cert.pem.h and claim_key.pem.h next to it and
 *    paste the PEMs from the app's "Claim certificate" screen between the
 *    marker lines (every .pem.h under main/ is git-ignored).
 * 3. `idf.py reconfigure && idf.py build` — the file is detected at
 *    configure time (main/CMakeLists.txt). Without it the library's empty
 *    defaults apply and the claim step is skipped.
 *
 * C++ because the .pem.h files are C++11 raw strings; CyThingEsp32.h gives
 * the two arrays C linkage. See src/aws/claim_credentials.h.
 */
#include "CyThingEsp32.h"

const char claim_cert_pem[] =
#include "claim_cert.pem.h"
;

const char claim_key_pem[] =
#include "claim_key.pem.h"
;
